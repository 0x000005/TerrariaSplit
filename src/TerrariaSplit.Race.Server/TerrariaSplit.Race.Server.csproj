<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
    <Version>$(TerrariaSplitProductVersion)</Version>
    <FileVersion>$(TerrariaSplitProductVersion)</FileVersion>
    <AssemblyVersion>$(TerrariaSplitProductVersion)</AssemblyVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSelfContained>true</PublishSelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <PublishDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..\..\publish\TerrariaSplit.Race.Server-v$(FileVersion)-$(RuntimeIdentifier)'))</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TerrariaSplit.Race.Contracts\TerrariaSplit.Race.Contracts.csproj" />
  </ItemGroup>

  <Target Name="TerrariaSplitCleanServerFinalPublishDirectory"
          BeforeTargets="PrepareForPublish"
          Condition="'$(Configuration)' == 'Release' and '$(PublishDir)' != ''">
    <RemoveDir Directories="$(PublishDir)" />
  </Target>

</Project>
