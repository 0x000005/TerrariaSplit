<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Balanced Desktop Density Tokens -->
    <FontFamily x:Key="PrimaryFontFamily">Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="MonoFontFamily">Cascadia Mono, Consolas, Courier New</FontFamily>
    <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI, Microsoft YaHei UI</FontFamily>

    <sys:Double x:Key="FontSizeSub">12</sys:Double>
    <sys:Double x:Key="FontSizeBody">13.5</sys:Double>
    <sys:Double x:Key="FontSizeTitle">13</sys:Double>
    <sys:Double x:Key="FontSizeHeading">14.5</sys:Double>
    <sys:Double x:Key="FontSizeKpi">18</sys:Double>

    <sys:Double x:Key="ControlContentThemeFontSize">13.5</sys:Double>
    <sys:Double x:Key="BodyTextBlockFontSize">13.5</sys:Double>
    <sys:Double x:Key="ContentControlFontSize">13.5</sys:Double>
    <sys:Double x:Key="CaptionTextBlockFontSize">12</sys:Double>
    <sys:Double x:Key="ComboBoxMinHeight">30</sys:Double>
    <sys:Double x:Key="ComboBoxPopupMinHeight">32</sys:Double>
    <sys:Double x:Key="ComboBoxChevronSize">10</sys:Double>
    <Thickness x:Key="ComboBoxPadding">10,4,0,5</Thickness>
    <Thickness x:Key="ComboBoxChevronMargin">6,0,10,0</Thickness>
    <Thickness x:Key="ComboBoxItemContentMargin">10,6,10,6</Thickness>
    <sys:Double x:Key="TextControlThemeMinHeight">30</sys:Double>

    <sys:Double x:Key="TitleBarHeight">38</sys:Double>
    <sys:Double x:Key="TitleBarButtonWidth">40</sys:Double>
    <sys:Double x:Key="SidebarWidth">188</sys:Double>
    <sys:Double x:Key="ControlHeight">30</sys:Double>
    <sys:Double x:Key="SmallButtonHeight">27</sys:Double>
    <sys:Double x:Key="NavItemHeight">32</sys:Double>
    <sys:Double x:Key="SettingRowHeight">42</sys:Double>
    <sys:Double x:Key="TableHeaderHeight">32</sys:Double>
    <sys:Double x:Key="TableRowHeight">38</sys:Double>

    <sys:Double x:Key="ToggleWidth">40</sys:Double>
    <sys:Double x:Key="ToggleHeight">20</sys:Double>
    <sys:Double x:Key="ToggleThumbHostSize">18</sys:Double>
    <sys:Double x:Key="ToggleThumbSize">12</sys:Double>
    <sys:Double x:Key="ToggleThumbHoverSize">13.5</sys:Double>
    <CornerRadius x:Key="ToggleCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="ToggleThumbCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="ToggleThumbHoverCornerRadius">6.75</CornerRadius>
    <sys:Double x:Key="ToggleThumbTranslateOn">20</sys:Double>
    <sys:Double x:Key="CheckboxSize">18</sys:Double>

    <CornerRadius x:Key="WindowCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadius">5</CornerRadius>
    <CornerRadius x:Key="BadgeCornerRadius">5</CornerRadius>

    <Thickness x:Key="PagePadding">18</Thickness>
    <Thickness x:Key="CardPadding">16,10</Thickness>
    <Thickness x:Key="SettingRowPadding">0,5</Thickness>
    <Thickness x:Key="ButtonPadding">12,4,12,5</Thickness>
    <Thickness x:Key="ChipPadding">10,4</Thickness>
    <Thickness x:Key="InputPadding">9,0</Thickness>
    <Thickness x:Key="SectionSpacing">0,0,0,12</Thickness>
</ResourceDictionary>
