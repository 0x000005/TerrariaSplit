<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    mc:Ignorable="po">
    <!-- Fluent Amber: Neutral Win11 Dark base with warm gold-amber accent (Starward / classic RPG vibe) -->
    <Color x:Key="ThemeWindowBgColor">#FF201F1E</Color>
    <Color x:Key="ThemeSidebarBgColor">#FF1B1A19</Color>
    <Color x:Key="ThemePageLayerBgColor">#FF201F1E</Color>
    <Color x:Key="ThemeLayerBgColor">#FF262524</Color>
    <Color x:Key="ThemeSurfaceColor">#FF2B2A29</Color>
    <Color x:Key="ThemeSurfaceHoverColor">#FF383735</Color>
    <Color x:Key="ThemeSurfaceRaisedColor">#FF32312F</Color>
    <Color x:Key="ThemeControlPressedColor">#FF272625</Color>
    <Color x:Key="ThemeFieldBgColor">#FF252423</Color>
    <Color x:Key="ThemeFieldHoverColor">#FF2D2C2B</Color>
    <Color x:Key="ThemeFieldFocusedColor">#FF1E1D1C</Color>
    <Color x:Key="ThemePopupBgColor">#FF2C2B2A</Color>
    <Color x:Key="ThemeFooterBgColor">#FF191817</Color>

    <Color x:Key="ThemeBorderColor">#12FFFFFF</Color>
    <Color x:Key="ThemeBorderStrongColor">#1EFFFFFF</Color>
    <Color x:Key="ThemeCardStrokeColor">#28000000</Color>
    <Color x:Key="ThemeDwmBorderColor">#FF363432</Color>

    <Color x:Key="ThemeTextPrimaryColor">#FFFFFFFF</Color>
    <Color x:Key="ThemeTextSecondaryColor">#C8FFFFFF</Color>
    <Color x:Key="ThemeTextMutedColor">#8CFFFFFF</Color>

    <!-- Warm restrained champagne-amber -->
    <Color x:Key="ThemeAccentColor">#FFE2B76E</Color>
    <Color x:Key="ThemeAccentHoverColor">#FFECC786</Color>
    <Color x:Key="ThemeAccentPressedColor">#FFCFA156</Color>
    <Color x:Key="ThemeAccentTextColor">#FF1A1308</Color>
    <Color x:Key="ThemeAccentSoftColor">#1AE2B76E</Color>
    <Color x:Key="ThemeSecondaryColor">#C8FFFFFF</Color>

    <Color x:Key="ThemeSuccessColor">#FF6CCB5F</Color>
    <Color x:Key="ThemeSuccessSoftColor">#1C6CCB5F</Color>
    <Color x:Key="ThemeWarningColor">#FFFCE100</Color>
    <Color x:Key="ThemeWarningSoftColor">#1CFCE100</Color>
    <Color x:Key="ThemeDangerColor">#FFFF99A4</Color>
    <Color x:Key="ThemeDangerSoftColor">#20FF99A4</Color>

    <SolidColorBrush x:Key="WindowBgBrush" Color="{StaticResource ThemeWindowBgColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="SidebarBgBrush" Color="{StaticResource ThemeSidebarBgColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="PageLayerBgBrush" Color="{StaticResource ThemePageLayerBgColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="LayerBgBrush" Color="{StaticResource ThemeLayerBgColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource ThemeSurfaceColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource ThemeSurfaceHoverColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource ThemeSurfaceRaisedColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="ControlPressedBrush" Color="{StaticResource ThemeControlPressedColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="FieldBgBrush" Color="{StaticResource ThemeFieldBgColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="FieldHoverBrush" Color="{StaticResource ThemeFieldHoverColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="FieldFocusedBrush" Color="{StaticResource ThemeFieldFocusedColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="PopupBgBrush" Color="{StaticResource ThemePopupBgColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="FooterBgBrush" Color="{StaticResource ThemeFooterBgColor}" po:Freeze="True" />

    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource ThemeBorderColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource ThemeBorderStrongColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="CardStrokeBrush" Color="{StaticResource ThemeCardStrokeColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="InputBottomRestBrush" Color="#40FFFFFF" po:Freeze="True" />

    <LinearGradientBrush x:Key="ControlElevationBorderBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#1BFFFFFF" Offset="0" />
        <GradientStop Color="#12FFFFFF" Offset="0.14" />
        <GradientStop Color="#12FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentElevationBorderBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#28FFFFFF" Offset="0" />
        <GradientStop Color="#14000000" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource ThemeTextPrimaryColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource ThemeTextSecondaryColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource ThemeTextMutedColor}" po:Freeze="True" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource ThemeAccentColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource ThemeAccentHoverColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource ThemeAccentPressedColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource ThemeAccentTextColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource ThemeAccentSoftColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource ThemeSecondaryColor}" po:Freeze="True" />

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource ThemeSuccessColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="{StaticResource ThemeSuccessSoftColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource ThemeWarningColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="{StaticResource ThemeWarningSoftColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource ThemeDangerColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource ThemeDangerSoftColor}" po:Freeze="True" />

    <SolidColorBrush x:Key="TitleBarHoverBrush" Color="#14FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="TitleBarPressedBrush" Color="#0CFFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="TitleBarCloseHoverBrush" Color="#FFC42B1C" po:Freeze="True" />
    <SolidColorBrush x:Key="TitleBarClosePressedBrush" Color="#FF9E2216" po:Freeze="True" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#52FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#84FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="ToggleOffBorderBrush" Color="#99FFFFFF" po:Freeze="True" />
</ResourceDictionary>
