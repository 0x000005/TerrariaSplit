<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Compact Desktop Density Tokens (Native Win11 Fluent 2 tuned for mouse/keyboard density) -->
    <!-- Use static hinted Segoe UI + Microsoft YaHei UI to avoid WPF variable-font thin/fuzzy rendering -->
    <FontFamily x:Key="PrimaryFontFamily">Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="MonoFontFamily">Cascadia Mono, Consolas, Courier New</FontFamily>
    <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI, Microsoft YaHei UI</FontFamily>

    <sys:Double x:Key="FontSizeSub">11.5</sys:Double>
    <sys:Double x:Key="FontSizeBody">13</sys:Double>
    <sys:Double x:Key="FontSizeTitle">12.5</sys:Double>
    <sys:Double x:Key="FontSizeHeading">14</sys:Double>
    <sys:Double x:Key="FontSizeKpi">16.5</sys:Double>

    <!-- Override .NET 10 PresentationFramework.Fluent default 14px / 32px touch metrics to compact desktop -->
    <sys:Double x:Key="ControlContentThemeFontSize">13</sys:Double>
    <sys:Double x:Key="BodyTextBlockFontSize">13</sys:Double>
    <sys:Double x:Key="ContentControlFontSize">13</sys:Double>
    <sys:Double x:Key="CaptionTextBlockFontSize">11.5</sys:Double>
    <sys:Double x:Key="ComboBoxMinHeight">26</sys:Double>
    <sys:Double x:Key="ComboBoxPopupMinHeight">28</sys:Double>
    <sys:Double x:Key="ComboBoxChevronSize">9.5</sys:Double>
    <Thickness x:Key="ComboBoxPadding">10,2,0,3</Thickness>
    <Thickness x:Key="ComboBoxChevronMargin">4,0,8,0</Thickness>
    <Thickness x:Key="ComboBoxItemContentMargin">10,4,10,4</Thickness>
    <sys:Double x:Key="TextControlThemeMinHeight">26</sys:Double>

    <sys:Double x:Key="TitleBarHeight">34</sys:Double>
    <sys:Double x:Key="TitleBarButtonWidth">38</sys:Double>
    <sys:Double x:Key="SidebarWidth">168</sys:Double>
    <sys:Double x:Key="ControlHeight">26</sys:Double>
    <sys:Double x:Key="SmallButtonHeight">24</sys:Double>
    <sys:Double x:Key="NavItemHeight">30</sys:Double>
    <sys:Double x:Key="SettingRowHeight">36</sys:Double>
    <sys:Double x:Key="TableHeaderHeight">28</sys:Double>
    <sys:Double x:Key="TableRowHeight">34</sys:Double>

    <!-- Exact 2:1 WinUI 3 ToggleSwitch proportions scaled to compact 18px height -->
    <sys:Double x:Key="ToggleWidth">36</sys:Double>
    <sys:Double x:Key="ToggleHeight">18</sys:Double>
    <sys:Double x:Key="ToggleThumbHostSize">16</sys:Double>
    <sys:Double x:Key="ToggleThumbSize">10</sys:Double>
    <sys:Double x:Key="ToggleThumbHoverSize">11.5</sys:Double>
    <CornerRadius x:Key="ToggleCornerRadius">9</CornerRadius>
    <CornerRadius x:Key="ToggleThumbCornerRadius">5</CornerRadius>
    <CornerRadius x:Key="ToggleThumbHoverCornerRadius">5.75</CornerRadius>
    <sys:Double x:Key="ToggleThumbTranslateOn">18</sys:Double>
    <sys:Double x:Key="CheckboxSize">16</sys:Double>

    <CornerRadius x:Key="WindowCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="BadgeCornerRadius">4</CornerRadius>

    <Thickness x:Key="PagePadding">14</Thickness>
    <Thickness x:Key="CardPadding">14,9</Thickness>
    <Thickness x:Key="SettingRowPadding">0,4</Thickness>
    <Thickness x:Key="ButtonPadding">10,3,10,4</Thickness>
    <Thickness x:Key="ChipPadding">9,3</Thickness>
    <Thickness x:Key="InputPadding">8,0</Thickness>
    <Thickness x:Key="SectionSpacing">0,0,0,10</Thickness>
</ResourceDictionary>
