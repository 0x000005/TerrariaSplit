<controls:ModernWindow x:Class="TerrariaSplit.UI.Wpf.Windows.PracticeWorldPaletteWindow"
                       x:ClassModifier="internal"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:controls="clr-namespace:TerrariaSplit.UI.Wpf.Controls"
                       xmlns:conv="clr-namespace:TerrariaSplit.UI.Wpf.Converters"
                       Width="400"
                       ShowTitleBar="False"
                       ShowMinimizeButton="False"
                       ShowMaximizeButton="False"
                       ShowInTaskbar="False"
                       BackdropKind="Acrylic"
                       ResizeMode="NoResize"
                       CloseOnEscape="True"
                       SizeToContent="Height"
                       WindowStartupLocation="Manual">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="14,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PaletteTitleText"
                           Grid.Column="0"
                           FontSize="{DynamicResource FontSizeHeading}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="FooterHintText"
                           Grid.Column="1"
                           FontSize="{DynamicResource FontSizeSub}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <ListBox x:Name="SlotListBox"
                 Grid.Row="1"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="8,6"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,1" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="RowCard"
                                        Background="Transparent"
                                        CornerRadius="5"
                                        SnapsToDevicePixels="True">
                                    <Grid>
                                        <Border x:Name="SelectedPill"
                                                Width="3"
                                                Height="16"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                CornerRadius="1.5"
                                                Background="{DynamicResource AccentBrush}"
                                                Visibility="Collapsed" />
                                        <ContentPresenter Margin="10,6,10,6" />
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="RowCard" Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="RowCard" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                        <Setter TargetName="SelectedPill" Property="Visibility" Value="Visible" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsConfigured}" Value="False">
                                        <Setter TargetName="RowCard" Property="Opacity" Value="0.42" />
                                        <Setter TargetName="SelectedPill" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="Keycap"
                                Grid.Column="0"
                                Width="22"
                                Height="22"
                                CornerRadius="4"
                                Background="{DynamicResource SurfaceRaisedBrush}"
                                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                BorderThickness="1"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="KeycapText"
                                       Text="{Binding KeyLabel}"
                                       FontFamily="{DynamicResource MonoFontFamily}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayName}"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding MetadataText}"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding MetadataText, Converter={x:Static conv:StringNotEmptyToVisibilityConverter.Instance}}" />
                        </StackPanel>
                    </Grid>
                    <DataTemplate.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True" />
                                <Condition Binding="{Binding IsConfigured}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Keycap" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Keycap" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="KeycapText" Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                        </MultiDataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</controls:ModernWindow>
