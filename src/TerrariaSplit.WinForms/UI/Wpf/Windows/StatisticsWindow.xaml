<controls:ModernWindow x:Class="TerrariaSplit.UI.Wpf.Windows.StatisticsWindow"
                       x:ClassModifier="internal"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:controls="clr-namespace:TerrariaSplit.UI.Wpf.Controls"
                       xmlns:conv="clr-namespace:TerrariaSplit.UI.Wpf.Converters"
                       Width="1020"
                       Height="590"
                       MinWidth="920"
                       MinHeight="420"
                       ShowInTaskbar="True"
                       WindowStartupLocation="CenterScreen">
    <controls:ModernWindow.Resources>
        <Style x:Key="TotalComparisonTextStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="8,0,0,1" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
    </controls:ModernWindow.Resources>
    <Border Background="{DynamicResource PageLayerBgBrush}"
            RenderOptions.ClearTypeHint="Enabled">
    <Grid Margin="14,10,14,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Selector Toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock x:Name="SelectedRunLabel"
                           Style="{DynamicResource SubtleTextStyle}"
                           Margin="1,0,0,4" />
                <ComboBox x:Name="SelectedRunComboBox" />
            </StackPanel>

            <Grid Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="ReferenceRunLabel"
                               Style="{DynamicResource SubtleTextStyle}"
                               Margin="1,0,0,4" />
                    <ComboBox x:Name="ReferenceRunComboBox" />
                </StackPanel>
                <CheckBox x:Name="ShowComparisonToggle"
                          Grid.Column="1"
                          Style="{DynamicResource ToggleSwitchStyle}"
                          VerticalAlignment="Bottom"
                          Margin="16,0,0,3"
                          IsChecked="False" />
            </Grid>
        </Grid>

        <!-- Clean Neutral Summary Strip -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="KpiSelectedCard"
                    Grid.Column="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource CardStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="11,8">
                <StackPanel>
                    <TextBlock x:Name="KpiSelectedLabel" Style="{DynamicResource SubtleTextStyle}" />
                    <TextBlock x:Name="KpiSelectedValue"
                               Margin="0,3,0,0"
                               FontFamily="{DynamicResource MonoFontFamily}"
                               FontSize="{DynamicResource FontSizeKpi}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Typography.NumeralAlignment="Tabular" />
                </StackPanel>
            </Border>

            <Border x:Name="KpiReferenceCard"
                    Grid.Column="2"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource CardStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="11,8">
                <StackPanel>
                    <TextBlock x:Name="KpiReferenceLabel" Style="{DynamicResource SubtleTextStyle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock x:Name="KpiReferenceValue"
                                   FontFamily="{DynamicResource MonoFontFamily}"
                                   FontSize="{DynamicResource FontSizeKpi}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Typography.NumeralAlignment="Tabular" />
                        <TextBlock x:Name="KpiReferenceDeltaText" Style="{StaticResource TotalComparisonTextStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border x:Name="KpiPbCard"
                    Grid.Column="4"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource CardStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="11,8">
                <StackPanel>
                    <TextBlock x:Name="KpiPbLabel" Style="{DynamicResource SubtleTextStyle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock x:Name="KpiPbValue"
                                   FontFamily="{DynamicResource MonoFontFamily}"
                                   FontSize="{DynamicResource FontSizeKpi}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Typography.NumeralAlignment="Tabular" />
                        <TextBlock x:Name="KpiPbDeltaText" Style="{StaticResource TotalComparisonTextStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border x:Name="KpiSobCard"
                    Grid.Column="6"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource CardStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="11,8">
                <StackPanel>
                    <TextBlock x:Name="KpiSobLabel" Style="{DynamicResource SubtleTextStyle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock x:Name="KpiSobValue"
                                   FontFamily="{DynamicResource MonoFontFamily}"
                                   FontSize="{DynamicResource FontSizeKpi}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Typography.NumeralAlignment="Tabular" />
                        <TextBlock x:Name="KpiSobDeltaText" Style="{StaticResource TotalComparisonTextStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Pixel-Aligned Split Comparison Table (True Merged Segment Cells) -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource CardStrokeBrush}"
                BorderThickness="1"
                CornerRadius="6"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Sticky Header (right padding dynamically matches ScrollBar width) -->
                <Border x:Name="HeaderRowContainer"
                        Grid.Row="0"
                        MinHeight="{DynamicResource TableHeaderHeight}"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="6,6,0,0"
                        Padding="12,5,12,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition x:Name="HeaderPbTimeCol" Width="120" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition x:Name="HeaderPbSegCol" Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ColSplitHeader" Grid.Column="0" Style="{DynamicResource SubtleTextStyle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ColSelTimeHeader" Grid.Column="1" Style="{DynamicResource SubtleTextStyle}" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="3,0" />
                        <TextBlock x:Name="ColRefTimeHeader" Grid.Column="2" Style="{DynamicResource SubtleTextStyle}" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="3,0" />
                        <TextBlock x:Name="ColPbTimeHeader" Grid.Column="3" Style="{DynamicResource SubtleTextStyle}" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="3,0" />
                        <TextBlock x:Name="ColSelSegHeader" Grid.Column="4" Style="{DynamicResource SubtleTextStyle}" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="3,0" />
                        <TextBlock x:Name="ColRefSegHeader" Grid.Column="5" Style="{DynamicResource SubtleTextStyle}" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="3,0" />
                        <TextBlock x:Name="ColPbSegHeader" Grid.Column="6" Style="{DynamicResource SubtleTextStyle}" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="3,0" />
                    </Grid>
                </Border>

                <!-- Grouped Rows (Each block merges upward through attached rows to previous main group) -->
                <ScrollViewer x:Name="RowsScrollViewer"
                              Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="RowsItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="GroupBorder"
                                        Background="Transparent"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,0,0,1">
                                    <Grid Margin="12,0,12,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="{Binding PbTimeColumnLength}" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="{Binding PbSegmentColumnLength}" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Left cumulative columns: stacked per-condition rows -->
                                        <ItemsControl Grid.Column="0" Grid.ColumnSpan="4" ItemsSource="{Binding SubRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="SubRowBorder"
                                                            MinHeight="{DynamicResource TableRowHeight}"
                                                            Background="Transparent"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="{Binding InnerDividerThickness}"
                                                            Padding="0,3">
                                                        <Grid VerticalAlignment="Center">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="110" />
                                                                <ColumnDefinition Width="110" />
                                                                <ColumnDefinition Width="{Binding PbColumnLength}" />
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Image Source="{Binding Icon}"
                                                                       Width="18"
                                                                       Height="18"
                                                                       Margin="0,0,8,0"
                                                                       Stretch="Uniform"
                                                                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                                       Visibility="{Binding Icon, Converter={x:Static conv:NullToVisibilityConverter.Instance}}" />
                                                                <TextBlock Text="{Binding DisplayName}"
                                                                           FontSize="{DynamicResource FontSizeBody}"
                                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           VerticalAlignment="Center" />
                                                            </StackPanel>

                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding PersonalTimeText}"
                                                                       Style="{DynamicResource MonoTabularTextStyle}"
                                                                       Foreground="{Binding PersonalTimeForeground}"
                                                                       Width="{Binding PersonalTimeWidth}"
                                                                       TextAlignment="{Binding PersonalTimeAlignment}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />

                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding ReferenceTimeText}"
                                                                       Style="{DynamicResource MonoTabularTextStyle}"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       Width="{Binding ReferenceTimeWidth}"
                                                                       TextAlignment="{Binding ReferenceTimeAlignment}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />

                                                            <TextBlock Grid.Column="3"
                                                                       Text="{Binding PersonalBestText}"
                                                                       Style="{DynamicResource MonoTabularTextStyle}"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       Width="{Binding PersonalBestWidth}"
                                                                       TextAlignment="{Binding PersonalBestAlignment}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Visibility="{Binding PbColumnVisibility}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Right segment columns: vertically merged across attached + main rows of the segment -->
                                        <Grid Grid.Column="4" Grid.ColumnSpan="3">
                                            <Border Width="1"
                                                    HorizontalAlignment="Left"
                                                    Background="{DynamicResource BorderBrush}" />
                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="{Binding PbSegmentColumnLength}" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding PersonalSegmentText}"
                                                           Style="{DynamicResource MonoTabularTextStyle}"
                                                           Foreground="{Binding PersonalSegmentForeground}"
                                                           FontWeight="{Binding PersonalSegmentFontWeight}"
                                                           Width="{Binding PersonalSegmentWidth}"
                                                           TextAlignment="{Binding PersonalSegmentAlignment}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding ReferenceSegmentText}"
                                                           Style="{DynamicResource MonoTabularTextStyle}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Width="{Binding ReferenceSegmentWidth}"
                                                           TextAlignment="{Binding ReferenceSegmentAlignment}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />

                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding PersonalBestSegmentText}"
                                                           Style="{DynamicResource MonoTabularTextStyle}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Width="{Binding PersonalBestSegmentWidth}"
                                                           TextAlignment="{Binding PersonalBestSegmentAlignment}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding PbSegmentColumnVisibility}" />
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="GroupBorder" Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
    </Border>
</controls:ModernWindow>
