<controls:ModernWindow x:Class="TerrariaSplit.UI.Wpf.Windows.RaceWindow"
                       x:ClassModifier="internal"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:controls="clr-namespace:TerrariaSplit.UI.Wpf.Controls"
                       Width="1120"
                       Height="650"
                       MinWidth="1020"
                       MinHeight="520"
                       ShowInTaskbar="True"
                       WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="156" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0"
                RenderOptions.ClearTypeHint="Enabled">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="NavPanel"
                            Orientation="Vertical"
                            Margin="8,8,8,8" />
            </ScrollViewer>
        </Border>

        <Border Grid.Column="1"
                Background="{DynamicResource PageLayerBgBrush}"
                RenderOptions.ClearTypeHint="Enabled">
            <Grid x:Name="PageHostGrid" />
        </Border>
    </Grid>
</controls:ModernWindow>
