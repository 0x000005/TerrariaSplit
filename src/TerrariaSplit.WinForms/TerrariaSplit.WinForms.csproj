<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>$(TerrariaSplitProductVersion)</Version>
    <FileVersion>$(TerrariaSplitProductVersion)</FileVersion>
    <AssemblyVersion>$(TerrariaSplitProductVersion)</AssemblyVersion>
    <AssemblyName>TerrariaSplit</AssemblyName>
    <RootNamespace>TerrariaSplit</RootNamespace>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin\**;obj\**;.build-check\**;.check\**;.verify\**;.codex-build-check\**;.codex-memory-probe\**;.codex-verify\**;.codex_bin\**;.codex_obj\**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSelfContained>true</PublishSelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>true</PublishReadyToRun>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishAot>false</PublishAot>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <PublishDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..\..\publish\TerrariaSplit-v$(FileVersion)-$(RuntimeIdentifier)'))</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\Icons\**\*.*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\TerrariaWorldNames\*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Speech" Version="10.0.9" />
    <ProjectReference Include="..\TerrariaSplit.Application\TerrariaSplit.Application.csproj" />
    <ProjectReference Include="..\TerrariaSplit.Configuration\TerrariaSplit.Configuration.csproj" />
    <ProjectReference Include="..\TerrariaSplit.Domain\TerrariaSplit.Domain.csproj" />
    <ProjectReference Include="..\TerrariaSplit.Infrastructure\TerrariaSplit.Infrastructure.csproj" />
    <ProjectReference Include="..\TerrariaSplit.Infrastructure.Windows\TerrariaSplit.Infrastructure.Windows.csproj" />
    <ProjectReference Include="..\TerrariaSplit.MemoryBridge\TerrariaSplit.MemoryBridge.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      Private="false" />
    <ProjectReference Include="..\TerrariaSplit.MemoryBridge.Payload\TerrariaSplit.MemoryBridge.Payload.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishSelfContained;PublishSingleFile"
                      Private="false" />
    <ProjectReference Include="..\TerrariaSplit.Race.Client\TerrariaSplit.Race.Client.csproj" />
    <ProjectReference Include="..\TerrariaSplit.Race.Contracts\TerrariaSplit.Race.Contracts.csproj" />
    <ProjectReference Include="..\TerrariaSplit.Race.InGame\TerrariaSplit.Race.InGame.csproj" />
    <ProjectReference Include="..\TerrariaSplit.Statistics\TerrariaSplit.Statistics.csproj" />
    <ProjectReference Include="..\TerrariaSplit.Storage\TerrariaSplit.Storage.csproj" />
    <ProjectReference Include="..\TerrariaSplit.Terraria\TerrariaSplit.Terraria.csproj" />
  </ItemGroup>

  <Import Project="Build\MemoryBridge.targets" />
  <Import Project="Build\WorldFilter.targets" />
  <Import Project="Build\ReleaseLayout.targets" />

</Project>
