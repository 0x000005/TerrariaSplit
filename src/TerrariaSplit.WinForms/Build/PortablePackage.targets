<Project>
  <Target
    Name="CreateTerrariaSplitPortableArchive"
    AfterTargets="Publish"
    DependsOnTargets="TerrariaSplitCopyMemoryBridgeToPublishDirectory;TerrariaSplitCopyWorldFilterToPublishDirectory;TerrariaSplitCopyWorldGuardToPublishDirectory"
    Condition="'$(Configuration)' == 'Release' and '$(TerrariaSplitCreatePortableArchive)' == 'true'">
    <PropertyGroup>
      <TerrariaSplitPortableArchivePath Condition="'$(TerrariaSplitPortableArchivePath)' == ''">$([System.IO.Path]::GetFullPath('$(PublishDir)..\TerrariaSplit-v$(FileVersion)-win-x64.zip'))</TerrariaSplitPortableArchivePath>
    </PropertyGroup>
    <MakeDir Directories="$(PublishDir)Runtime" />
    <WriteLinesToFile
      File="$(PublishDir)Runtime\terrariasplit-update-manifest.json"
      Lines="{&quot;schemaVersion&quot;:1,&quot;managedRoots&quot;:[&quot;TerrariaSplit.exe&quot;,&quot;TerrariaSplit.MemoryBridge.exe&quot;,&quot;TerrariaSplit.WorldFilter.exe&quot;,&quot;Runtime&quot;,&quot;Assets&quot;]}"
      Overwrite="true"
      Encoding="UTF-8" />
    <ZipDirectory
      SourceDirectory="$(PublishDir)"
      DestinationFile="$(TerrariaSplitPortableArchivePath)"
      Overwrite="true" />
    <Message Importance="high" Text="Created portable archive: $(TerrariaSplitPortableArchivePath)" />
  </Target>
</Project>
