<Project>
  <PropertyGroup>
    <TerrariaSplitWorldGuardPayloadProject>$(MSBuildThisFileDirectory)..\..\TerrariaSplit.WorldGuard.Payload\TerrariaSplit.WorldGuard.Payload.csproj</TerrariaSplitWorldGuardPayloadProject>
    <TerrariaSplitWorldGuardPayloadDirectory>$(MSBuildThisFileDirectory)..\..\TerrariaSplit.WorldGuard.Payload\</TerrariaSplitWorldGuardPayloadDirectory>
    <TerrariaSplitWorldGuardNativeDirectory>$(MSBuildThisFileDirectory)..\..\TerrariaSplit.WorldGuard.Native\</TerrariaSplitWorldGuardNativeDirectory>
    <TerrariaSplitWorldGuardTargetFramework>net10.0-windows</TerrariaSplitWorldGuardTargetFramework>
    <TerrariaSplitWorldGuardRuntimeIdentifier>win-x86</TerrariaSplitWorldGuardRuntimeIdentifier>
    <TerrariaSplitWorldGuardOutputSubdirectory>Runtime\Injector\</TerrariaSplitWorldGuardOutputSubdirectory>
    <TerrariaSplitWorldGuardPayloadOutputDirectory>$(TerrariaSplitWorldGuardPayloadDirectory)bin\$(Configuration)\net40\</TerrariaSplitWorldGuardPayloadOutputDirectory>
    <TerrariaSplitWorldGuardCompatibilityManifest>$(TerrariaSplitWorldGuardPayloadDirectory)terraria-compatibility.json</TerrariaSplitWorldGuardCompatibilityManifest>
    <TerrariaSplitWorldGuardNativeOutputDirectory>$(TerrariaSplitWorldGuardNativeDirectory)obj\$(Configuration)</TerrariaSplitWorldGuardNativeOutputDirectory>
  </PropertyGroup>

  <Target Name="TerrariaSplitBuildWorldGuardManaged"
          BeforeTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(TerrariaSplitSkipWorldGuard)' != 'true'">
    <MSBuild Projects="$(TerrariaSplitWorldGuardPayloadProject)"
             Targets="Build"
             RemoveProperties="RuntimeIdentifier;SelfContained;PublishSelfContained;PublishSingleFile"
             Properties="Configuration=$(Configuration);UseSharedCompilation=false;Version=$(Version);FileVersion=$(FileVersion);AssemblyVersion=$(Version)" />
  </Target>

  <Target Name="TerrariaSplitBuildWorldGuardNative"
          BeforeTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(TerrariaSplitSkipWorldGuard)' != 'true'">
    <Exec Command="pwsh -NoProfile -File &quot;$(TerrariaSplitWorldGuardNativeDirectory)build-native.ps1&quot; -OutputDirectory &quot;$(TerrariaSplitWorldGuardNativeOutputDirectory)&quot; -Configuration $(Configuration)" />
  </Target>

  <Target Name="TerrariaSplitCopyWorldGuardToOutput"
          AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(TerrariaSplitSkipWorldGuard)' != 'true'">
    <ItemGroup>
      <TerrariaSplitWorldGuardBuiltFile Include="$(TerrariaSplitWorldGuardPayloadOutputDirectory)TerrariaSplit.WorldGuard.Payload.dll" />
      <TerrariaSplitWorldGuardBuiltFile Include="$(TerrariaSplitWorldGuardPayloadOutputDirectory)0Harmony.dll" />
      <TerrariaSplitWorldGuardBuiltFile Include="$(TerrariaSplitWorldGuardPayloadOutputDirectory)TerrariaSplit.Race.Determinism.dll" />
      <TerrariaSplitWorldGuardBuiltFile Include="$(TerrariaSplitWorldGuardCompatibilityManifest)" />
      <TerrariaSplitWorldGuardBuiltFile Include="$(TerrariaSplitWorldGuardNativeOutputDirectory)\TerrariaSplit.WorldGuard.Bootstrap.dll" />
    </ItemGroup>

    <Copy SourceFiles="@(TerrariaSplitWorldGuardBuiltFile)"
          DestinationFiles="@(TerrariaSplitWorldGuardBuiltFile->'$(TargetDir)$(TerrariaSplitWorldGuardOutputSubdirectory)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="TerrariaSplitPublishWorldGuard"
          BeforeTargets="ComputeFilesToPublish"
          DependsOnTargets="TerrariaSplitBuildWorldGuardNative"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(TerrariaSplitSkipWorldGuard)' != 'true'">
    <MSBuild Projects="$(TerrariaSplitWorldGuardPayloadProject)"
             Targets="Build"
             RemoveProperties="RuntimeIdentifier;SelfContained;PublishSelfContained;PublishSingleFile"
             Properties="Configuration=$(Configuration);UseSharedCompilation=false;Version=$(Version);FileVersion=$(FileVersion);AssemblyVersion=$(Version)" />
    <ItemGroup>
      <TerrariaSplitWorldGuardPublishedFile Include="$(TerrariaSplitWorldGuardPayloadOutputDirectory)TerrariaSplit.WorldGuard.Payload.dll" />
      <TerrariaSplitWorldGuardPublishedFile Include="$(TerrariaSplitWorldGuardPayloadOutputDirectory)0Harmony.dll" />
      <TerrariaSplitWorldGuardPublishedFile Include="$(TerrariaSplitWorldGuardPayloadOutputDirectory)TerrariaSplit.Race.Determinism.dll" />
      <TerrariaSplitWorldGuardPublishedFile Include="$(TerrariaSplitWorldGuardCompatibilityManifest)" />
      <TerrariaSplitWorldGuardPublishedFile Include="$(TerrariaSplitWorldGuardNativeOutputDirectory)\TerrariaSplit.WorldGuard.Bootstrap.dll" />
      <ResolvedFileToPublish Include="@(TerrariaSplitWorldGuardPublishedFile)">
        <RelativePath>$(TerrariaSplitWorldGuardOutputSubdirectory)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <Target Name="TerrariaSplitCopyWorldGuardToPublishDirectory"
          AfterTargets="Publish"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(TerrariaSplitSkipWorldGuard)' != 'true' and '$(PublishDir)' != ''">
    <ItemGroup>
      <TerrariaSplitWorldGuardPublishedFile Include="$(TerrariaSplitWorldGuardPayloadOutputDirectory)TerrariaSplit.WorldGuard.Payload.dll" />
      <TerrariaSplitWorldGuardPublishedFile Include="$(TerrariaSplitWorldGuardPayloadOutputDirectory)0Harmony.dll" />
      <TerrariaSplitWorldGuardPublishedFile Include="$(TerrariaSplitWorldGuardPayloadOutputDirectory)TerrariaSplit.Race.Determinism.dll" />
      <TerrariaSplitWorldGuardPublishedFile Include="$(TerrariaSplitWorldGuardCompatibilityManifest)" />
      <TerrariaSplitWorldGuardPublishedFile Include="$(TerrariaSplitWorldGuardNativeOutputDirectory)\TerrariaSplit.WorldGuard.Bootstrap.dll" />
    </ItemGroup>

    <Copy SourceFiles="@(TerrariaSplitWorldGuardPublishedFile)"
          DestinationFiles="@(TerrariaSplitWorldGuardPublishedFile->'$(PublishDir)$(TerrariaSplitWorldGuardOutputSubdirectory)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
