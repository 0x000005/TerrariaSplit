<Project>

  <PropertyGroup>
    <BaseIntermediateOutputPath>Temp\tests\obj\</BaseIntermediateOutputPath>
    <BaseOutputPath>Temp\tests\bin\</BaseOutputPath>
  </PropertyGroup>

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- This custom executable test harness intentionally references the WinForms executable assembly. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Next\*.cs" />
    <Compile Include="..\src\TerrariaSplit.WorldGuard.Payload\RaceUiReflection.cs"
             Link="Support\RaceUiReflection.cs" />
    <Compile Include="..\src\TerrariaSplit.WorldGuard.Payload\RaceUiRuntimeFailure.cs"
             Link="Support\RaceUiRuntimeFailure.cs" />
    <ProjectReference Include="..\src\TerrariaSplit.Application\TerrariaSplit.Application.csproj" />
    <ProjectReference Include="..\src\TerrariaSplit.Configuration\TerrariaSplit.Configuration.csproj" />
    <ProjectReference Include="..\src\TerrariaSplit.Domain\TerrariaSplit.Domain.csproj" />
    <ProjectReference Include="..\src\TerrariaSplit.Infrastructure\TerrariaSplit.Infrastructure.csproj" />
    <ProjectReference Include="..\src\TerrariaSplit.Infrastructure.Windows\TerrariaSplit.Infrastructure.Windows.csproj" />
    <ProjectReference Include="..\src\TerrariaSplit.Race.Client\TerrariaSplit.Race.Client.csproj" />
    <ProjectReference Include="..\src\TerrariaSplit.Race.Contracts\TerrariaSplit.Race.Contracts.csproj" />
    <ProjectReference Include="..\src\TerrariaSplit.Race.Determinism\TerrariaSplit.Race.Determinism.csproj" />
    <ProjectReference Include="..\src\TerrariaSplit.Race.InGame\TerrariaSplit.Race.InGame.csproj" />
    <ProjectReference Include="..\src\TerrariaSplit.Race.Server\TerrariaSplit.Race.Server.csproj" />
    <ProjectReference Include="..\src\TerrariaSplit.Statistics\TerrariaSplit.Statistics.csproj" />
    <ProjectReference Include="..\src\TerrariaSplit.Storage\TerrariaSplit.Storage.csproj" />
    <ProjectReference Include="..\src\TerrariaSplit.Terraria\TerrariaSplit.Terraria.csproj" />
    <ProjectReference Include="..\src\TerrariaSplit.WinForms\TerrariaSplit.WinForms.csproj" />
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

</Project>
