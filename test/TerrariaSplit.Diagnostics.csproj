<Project>
  <PropertyGroup>
    <AssemblyName>TerrariaSplit.Tests</AssemblyName>
    <BaseIntermediateOutputPath>Temp\diagnostics\obj\</BaseIntermediateOutputPath>
    <BaseOutputPath>Temp\diagnostics\bin\</BaseOutputPath>
  </PropertyGroup>

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Diagnostics\Program.cs" />
    <Compile Include="Diagnostics\GlobalUsings.cs" />
    <Compile Include="Code\Diagnostics\*.cs" />
    <ProjectReference Include="..\src\TerrariaSplit.Configuration\TerrariaSplit.Configuration.csproj" />
    <ProjectReference Include="..\src\TerrariaSplit.Terraria\TerrariaSplit.Terraria.csproj" />
    <ProjectReference Include="..\src\TerrariaSplit.WorldGeneration\TerrariaSplit.WorldGeneration.csproj" />
    <ProjectReference Include="..\src\TerrariaSplit.WinForms\TerrariaSplit.WinForms.csproj" />
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
